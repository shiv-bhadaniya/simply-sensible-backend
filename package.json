{
  "name": "simply-sensible-microservices",
  "version": "2.0.0",
  "description": "E-commerce microservices architecture - converted from monolithic backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "docker-compose up -d",
    "dev": "docker-compose -f docker-compose.dev.yml up -d",
    "stop": "docker-compose down",
    "build": "docker-compose build",
    "logs": "docker-compose logs -f",
    "clean": "docker-compose down -v && docker system prune -f",
    "health": "curl http://localhost:3000/health",
    "test": "echo \"Run tests for individual services\" && exit 0"
  },
  "keywords": [
    "microservices",
    "ecommerce",
    "nodejs",
    "express",
    "mongodb",
    "docker",
    "api-gateway"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiv-bhadaniya/simply-sensible-backend.git"
  },
  "bugs": {
    "url": "https://github.com/shiv-bhadaniya/simply-sensible-backend/issues"
  },
  "homepage": "https://github.com/shiv-bhadaniya/simply-sensible-backend#readme"
}